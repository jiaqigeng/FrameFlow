{
  "name": "frameflow",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm --filter @frameflow/web dev",
    "build": "pnpm --filter @frameflow/web build",
    "build:amplify": "node scripts/build-amplify.mjs",
    "start": "pnpm --filter @frameflow/web start",
    "typecheck": "pnpm --filter @frameflow/web typecheck"
  }
}
